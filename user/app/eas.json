{
  "cli": {
    "version": ">= 15.0.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nesam-travels-api.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nesam-travels-api.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nesam-travels-api.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
