# The NESAM booking server (Vercel API). Without it the app calls Firebase Cloud Functions,
# which are not deployed, so fares never load and "Proceed to Book" stays disabled.
# Copy to .env for local `expo start`; EAS builds get it from eas.json.
EXPO_PUBLIC_API_URL=https://nesam-travels-api.vercel.app

# ── Groq AI Chatbot ─────────────────────────────────────────────────────────
# Paste your Groq API key here (gsk_...)
GROQ_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
