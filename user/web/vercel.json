{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "exit 1",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamcabs\\.in.*)"
        }
      ],
      "destination": "/sitemaps/sitemap-nesamcabs-in.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamcabs\\.in.*)"
        }
      ],
      "destination": "/robots/robots-nesamcabs-in.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtravels\\.com.*)"
        }
      ],
      "destination": "/sitemaps/sitemap-nesamtravels-com.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtravels\\.com.*)"
        }
      ],
      "destination": "/robots/robots-nesamtravels-com.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtravels\\.in.*)"
        }
      ],
      "destination": "/sitemaps/sitemap-nesamtravels-in.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtravels\\.in.*)"
        }
      ],
      "destination": "/robots/robots-nesamtravels-in.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtoursandtravels\\.com.*)"
        }
      ],
      "destination": "/sitemaps/sitemap-nesamtoursandtravels-com.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtoursandtravels\\.com.*)"
        }
      ],
      "destination": "/robots/robots-nesamtoursandtravels-com.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtoursandtravels\\.in.*)"
        }
      ],
      "destination": "/sitemaps/sitemap-nesamtoursandtravels-in.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "(?<domain>.*nesamtoursandtravels\\.in.*)"
        }
      ],
      "destination": "/robots/robots-nesamtoursandtravels-in.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemaps/sitemap-nesamcabs-com.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots/robots-nesamcabs-com.txt"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemaps/sitemap-index.xml"
    },
    {
      "source": "/(google[a-zA-Z0-9_-]+\\.html)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' https: wss:; frame-src https://www.google.com https://www.recaptcha.net https://*.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(robots.txt|robots/(.*))",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=UTF-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|sitemap-index.xml|sitemaps/(.*))",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=UTF-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(vehicles|art|brand|website-images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
