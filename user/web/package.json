{
  "name": "nesam-customer-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NESAM Travels customer booking website. Shares pricing, booking and Firebase logic with ../app.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:seo": "node scripts/generate-multi-domain-seo.js",
    "build": "node scripts/generate-multi-domain-seo.js && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^3.2.0"
  }
}
