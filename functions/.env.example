# Copy this file to .env and fill in real values once you have them. Until then,
# createRazorpayOrder / verifyRazorpayPayment respond with a PAYMENT_NOT_CONFIGURED
# error instead of crashing or fabricating a fake order.
#
# For local emulator use, `firebase emulators:start` reads .env automatically.
# For deployed functions, set secrets with:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
# Configure the Razorpay webhook URL for the chosen host after deployment.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Outbound messages. Unconfigured channels return not_configured.
# SMS_PROVIDER: msg91 or twilio. MSG91 requires an approved DLT flow template.
SMS_PROVIDER=
MSG91_AUTH_KEY=
SMS_MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_BOOKING_UPDATE=
WHATSAPP_TEMPLATE_BROADCAST=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Driver device attestation; requires Play Console / service account setup.
PLAY_INTEGRITY_PACKAGE_NAME=

# ── Vehicle auto-detection (spec page 13) ───────────────────────────────────
# There is NO public mParivahan / VAHAN API for private companies. Vehicle
# details are read through a licensed intermediary that sources them from the
# VAHAN register (RC verification providers such as Surepass, Signzy, IDfy,
# Karza…), or through an approved government requester account. Until these are
# set, lookupVehicleByRegistration answers `not_configured`; the apps then fall
# back to document upload with manual verification by the NESAM team.
#
#   VEHICLE_LOOKUP_PROVIDER   a label for logs and the cached record (e.g. surepass)
#   VEHICLE_LOOKUP_API_KEY    the provider credential (keep it a secret, never commit it)
#   VEHICLE_LOOKUP_API_URL    https endpoint; defaults to the provider's RC endpoint for `surepass`
#   VEHICLE_LOOKUP_AUTH_HEADER   header carrying the key; default "Authorization" (sent as a Bearer token)
#   VEHICLE_LOOKUP_ID_FIELD   request body field for the plate; default "id_number"
VEHICLE_LOOKUP_PROVIDER=
VEHICLE_LOOKUP_API_KEY=
VEHICLE_LOOKUP_API_URL=
VEHICLE_LOOKUP_AUTH_HEADER=
VEHICLE_LOOKUP_ID_FIELD=

# ── Vendor invitations ──────────────────────────────────────────────────────
# Public address of the vendor portal, used to build one-time invitation links
# (<VENDOR_PORTAL_URL>/?invite=CODE). Without it the admin panel shows the code only.
VENDOR_PORTAL_URL=

# ── Vercel deployment (see ../VERCEL_DEPLOYMENT.md) ─────────────────────────
# Set these as Vercel environment variables on the API project (never in the apps).
#   NESAM_SERVICE_ACCOUNT   service-account JSON (raw or base64)
#   NESAM_STORAGE_BUCKET    optional, defaults to <project>.firebasestorage.app
#   ALLOWED_ORIGINS            comma-separated front-end origins (CORS allow-list)
#   CRON_SECRET                random string, at least 16 characters
#   OTP_PEPPER                 random string used to hash verification codes
NESAM_SERVICE_ACCOUNT=
NESAM_STORAGE_BUCKET=
ALLOWED_ORIGINS=
CRON_SECRET=
OTP_PEPPER=
