rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENT-BASED ROLES + SERVER-AUTHORITATIVE BOOKING/PAYOUT CREATION
//
// Identity/role is derived entirely from Firestore documents:
//   • admins/{uid}   with role == 'admin' and status == 'active' → staff
//     member. Its staffRole is 'super_admin' or a staff_roles/{id}; its
//     permissions list (written only by the staff callables) grants the
//     modules below. An active admin without staffRole predates roles and
//     is a super admin.
//   • customers/{uid} with status 'Approved' (legacy 'Active') → customer
//   • vendors/{uid}   with status == 'APPROVED' → active vendor
//     (legacy 'Approved'/'Active' still honoured). Vendor lifecycle:
//     INCOMPLETE → PENDING_APPROVAL → APPROVED | CHANGES_REQUESTED | REJECTED,
//     APPROVED ⇄ SUSPENDED. Only an admin moves a vendor out of PENDING_APPROVAL.
//   • drivers/{uid}   with status == 'Approved' → active driver; an
//     independent driver has no vendorId, a fleet driver works for its vendor
// A user's profile doc id always equals their auth uid.
//
// Staff permissions (functions/src/permissions.ts):
//   operations  bookings, live trips, marketplace, dispatch
//   people      customers, vendors, drivers, KYC review
//   fleet       vehicles
//   pricing     vehicle category fares, fare rules, offers & coupons
//   content     services, tour packages, locations
//   finance     payments, invoices, earnings, payouts, fare overrides
//   compliance  penalties
//   reports     reports & analytics (read access to financial records)
//   engagement  notifications, reviews, support tickets
//   system      settings, B2B integrations
//   Staff accounts and roles are managed only by super admins, server-side.
//
// Anything a signed-in user is allowed to write here
// they can write directly. Every non-admin update is therefore pinned to an
// explicit allow-list of fields (affectedKeys().hasOnly) and, where it
// matters, to a legal state transition.
//
// Booking lifecycle (shared by all four panels). NESAM takes advance bookings only:
//   status:    Pending (admin review queue) → Approved (reviewed; NOT visible to
//              partners) → Confirmed (vendor reserved) → Assigned (driver set) →
//              Ongoing (trip started at the pickup) → Completed | Cancelled | Rejected.
//   fulfil:    after approval an admin chooses ONE route: publish to the marketplace
//              (marketplace_trips status Open — the only thing partners can read and
//              claim), assign a Vendor, or assign an Owner Driver.
//   trip:      tripSubStatus Not Started → Reached Pickup → Trip Started (boarding
//              OTP + vehicle photos verified) → Trip Ended,
//              advanced ONLY by the advanceTrip function (clients cannot write
//              status or stage fields). Legacy tripStage values still read.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function docPath(coll, id) {
      return /databases/$(database)/documents/$(coll)/$(id);
    }
    function adminData() {
      return get(docPath('admins', uid())).data;
    }
    function isAdmin() {
      return isSignedIn()
             && exists(docPath('admins', uid()))
             && adminData().role == 'admin'
             && adminData().status == 'active'
             // Staff IDs also carry a lifecycle status; only Active ones pass (others have none).
             && adminData().get('accountStatus', 'Active') == 'Active';
    }
    // ── Identity kinds: the same interpretation as identityKindOf (functions/src/permissions.ts) ──
    // master: staffRole 'super_admin', or a pre-roles record carrying no other access data (made
    //         explicit by migrateLegacyAdmins); staff: a Staff ID ('individual'), limited by its
    //         own matrix; legacy: a staff_roles id, limited by the explicit legacy mapping below;
    //         anything else: no access.
    function isMasterRecord(d) {
      return d.get('staffRole', '') == 'super_admin'
             || (d.get('staffRole', '') in ['', null]
                 && !('permissions' in d) && !('staffAccess' in d) && !('dutyPermissions' in d) && !('roleName' in d));
    }
    function isSuperAdmin() {
      return isAdmin() && isMasterRecord(adminData());
    }
    function isStaffId() {
      return adminData().get('staffRole', '') == 'individual';
    }
    function isLegacyStaff() {
      let role = adminData().get('staffRole', '');
      return role is string && role.matches('^[A-Za-z0-9_-]{2,40}$') && role != 'super_admin' && role != 'individual';
    }
    // An active staff member whose record grants permission p.
    function can(p) {
      return isAdmin()
             && (isMasterRecord(adminData())
                 || ((isStaffId() || isLegacyStaff()) && p in adminData().get('permissions', [])));
    }
    function staffMatrix() {
      return adminData().get('staffAccess', {});
    }
    // Legacy role-based staff: legacyAccessOf in functions/src/permissions.ts — a module when the
    // role holds any of its keys; a separate right when it holds any of LEGACY_FLAG_NEEDS.
    function legacyHas(keys) {
      return adminData().get('permissions', []).hasAny(keys);
    }
    function moduleKeys(module) {
      return {
        'Dashboard': ['operations', 'people', 'fleet', 'pricing', 'content', 'finance', 'compliance', 'reports', 'engagement', 'system'],
        'Bookings': ['operations'], 'Customers': ['people'], 'Partners & Fleet': ['people', 'fleet'], 'Accounts': ['finance'],
        'Invoices': ['finance'], 'Reports & GST': ['reports'], 'Communication': ['engagement'], 'Support': ['engagement'],
        'Settings': ['system', 'pricing', 'content'], 'Driver Partners': ['people'], 'Vendors': ['people'],
        'Vendor Drivers': ['people'], 'Vehicles': ['fleet'], 'Business accounts': ['people'], 'Penalties': ['compliance']
      }.get(module, []);
    }
    function legacyFlagKeys(group, key) {
      return {
        'sensitive': {'vendorPayout': ['operations', 'finance', 'reports', 'compliance'], 'bankDetails': ['finance']},
        'privacy': {'temporaryReveal': ['operations'], 'requestApproval': ['operations'], 'copyAfterReveal': ['operations']},
        'fleetSwap': {'driver': ['operations'], 'vehicle': ['operations']},
        'partnerRights': {'viewCoupons': ['operations', 'pricing', 'finance'], 'applyCoupon': ['pricing', 'finance'],
                          'createVehicle': ['fleet'], 'approveVehicleDocs': ['fleet'], 'createDriver': ['people'], 'approveDriverDocs': ['people']}
      }.get(group, {}).get(key, []);
    }
    function canAct(module, action) {
      return isSuperAdmin()
             || (isAdmin() && isStaffId() && action in staffMatrix().get('modules', {}).get(module, []))
             || (isAdmin() && isLegacyStaff() && module != 'Staff & Access' && legacyHas(moduleKeys(module)));
    }
    function staffFlag(group, key) {
      return isSuperAdmin()
             || (isAdmin() && isStaffId() && staffMatrix().get(group, {}).get(key, false) == true)
             || (isAdmin() && isLegacyStaff() && legacyHas(legacyFlagKeys(group, key)));
    }
    // Settlement approval limit (₹): a Staff ID's own; legacy finance roles LEGACY_SETTLEMENT_LIMIT.
    function withinBankLimit(amount) {
      return isSuperAdmin()
             || (isAdmin() && isStaffId() && amount <= staffMatrix().get('bankLimit', 0))
             || (isAdmin() && isLegacyStaff() && legacyHas(['finance']) && amount <= 100000000);
    }
    // ── Partner and vehicle records (everyone except the Master) ──
    // Each account-status change needs the entity's own account control, approval decisions need
    // the approval right and anything else the edit right. Permanent block / unblock and reopening a
    // Closed ID stay with the Master account. (admin/src/domain/partners.ts writes accountStatus
    // with every account action, plus the older status fields.)
    function controlOk(type, action) {
      return (isStaffId() && action in staffMatrix().get('accountControls', {}).get(type, []))
             || (isLegacyStaff() && legacyHas(type == 'Vehicles' ? ['fleet'] : ['people']));
    }
    function accountChangeOk(type) {
      let from = resource.data.get('accountStatus', 'Active');
      let to = request.resource.data.get('accountStatus', from);
      return (unchanged('disputeStatus') || controlOk(type, 'dispute'))
             && (from == to
                 || (from != 'Permanent block' && from != 'Closed'
                     && ((to == 'Suspended' && controlOk(type, 'suspend'))
                         || ((to == 'Inactive' || to == 'Closed') && controlOk(type, 'inactive'))
                         || (to == 'Dispute hold' && controlOk(type, 'dispute'))
                         || (to == 'Active' && from == 'Dispute hold' && controlOk(type, 'dispute'))
                         || (to == 'Active' && controlOk(type, 'reactivate')))));
    }
    // holdKeys: older status fields an account action also writes; they may only move with
    // accountStatus or an approval decision. approvalKeys: fields only an approval writes.
    function staffPartnerOk(type, approveOk, editOk, holdKeys, approvalKeys) {
      return isSuperAdmin() || (
        accountChangeOk(type)
        && (!changedKeys().hasAny(holdKeys) || changedKeys().hasAny(['accountStatus', 'approvalStatus']))
        && (!changedKeys().hasAny(approvalKeys) || approveOk)
        && (editOk || changedKeys().hasOnly(holdKeys.concat(approvalKeys).concat([
              'accountStatus', 'disputeStatus', 'disputeHandler', 'holdUntil', 'statusHistory', 'approvalHistory',
              'presenceStatus', 'updatedAt'])))
      );
    }
    function staffDriverOk() {
      let type = resource.data.get('vendorId', '') == '' ? 'Driver Partners' : 'Vendor Drivers';
      return staffPartnerOk(type,
        canAct(type, 'approve') && staffFlag('partnerRights', 'approveDriverDocs'),
        canAct(type, 'edit'),
        ['status', 'fleetStatus'],
        ['approvalStatus', 'docStatus', 'verified', 'rejectionReason', 'reviewedAt', 'approvedAt']);
    }
    // Financial records: payments, payouts, ledger, invoices, penalties.
    function canReadFinance() {
      return can('finance') || can('reports') || can('compliance');
    }
    // Records that carry partner payouts / company margin: also need the payout right.
    function canReadPayouts() {
      return canReadFinance() && staffFlag('sensitive', 'vendorPayout');
    }
    function isOwner(id) {
      return isSignedIn() && uid() == id;
    }
    function isCustomer() {
      return isSignedIn() && exists(docPath('customers', uid()))
             && get(docPath('customers', uid())).data.status in ['Approved', 'Active'];
    }
    function isVendor() {
      return isSignedIn() && exists(docPath('vendors', uid()));
    }
    function isDriver() {
      return isSignedIn() && exists(docPath('drivers', uid()));
    }
    function isApprovedVendorStatus(status) {
      return status in ['APPROVED', 'Approved', 'Active'];
    }
    function isApprovedVendor() {
      return isVendor() && isApprovedVendorStatus(get(docPath('vendors', uid())).data.status);
    }
    function isApprovedDriver() {
      return isDriver() && get(docPath('drivers', uid())).data.status == 'Approved'
             && get(docPath('drivers', uid())).data.get('fleetStatus', 'Active') != 'Suspended';
    }
    // Marketplace trips are for independent drivers; a fleet driver's trips
    // come from its vendor.
    function isApprovedIndependentDriver() {
      return isApprovedDriver() && get(docPath('drivers', uid())).data.get('vendorId', '') == '';
    }
    // E.164 phone number from a phone-auth token ('' when absent).
    function authPhone() {
      return request.auth.token.get('phone_number', '');
    }

    // ── Field-diff helpers ──────────────────────────────────────────────────
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }
    function unchanged(key) {
      return request.resource.data.get(key, null) == resource.data.get(key, null);
    }
    function isBlank(key) {
      return resource.data.get(key, '') == '' || resource.data.get(key, null) == null;
    }
    // A field that, once written, can never change.
    function writeOnce(key) {
      return !(key in resource.data) || unchanged(key);
    }

    // ── Staff ───────────────────────────────────────────────────────────────
    // Self-signup lands as a pending request; a super admin approves it with
    // approveAdminRequest. Admin documents are never written by clients.
    match /admins/{id} {
      allow create: if isOwner(id)
                     && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'status', 'createdAt'])
                     && request.resource.data.uid == id
                     && request.resource.data.role == 'pending'
                     && request.resource.data.status == 'pending';
      allow read: if isOwner(id) || isAdmin();
      allow update, delete: if false;
    }
    match /staff_roles/{roleId} {
      allow read: if isAdmin();
      allow write: if false; // saveStaffRole / deleteStaffRole
    }
    match /admin_audit/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Records from the old Staff screen: not linked to any sign-in account.
    match /staff/{staffId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Customers ───────────────────────────────────────────────────────────
    match /customers/{id} {
      allow create: if (can('people') && canAct('Customers', 'create')) || (
                       isOwner(id)
                       && request.resource.data.role == 'customer'
                       && request.resource.data.status == 'Approved'
                       && request.resource.data.get('walletBalance', 0) == 0
                     );
      allow read: if isOwner(id) || isAdmin();
      // Customers edit their own contact details only — never status, role
      // or wallet balance.
      allow update: if (can('people') && canAct('Customers', 'edit')) || (
                       isOwner(id)
                       && onlyChanges(['name', 'email', 'photoUrl', 'emergencyContact',
                                       'language', 'notificationPrefs', 'updatedAt'])
                     );
      allow delete: if can('people') && (isSuperAdmin() || isLegacyStaff());
    }

    // ── Invites (admin/vendor pre-register a partner by phone) ──────────────
    // Doc id is the invitee's E.164 phone (e.g. +919876543210). On first
    // phone-OTP sign-in the partner app reads its own invite to pre-fill
    // registration and inherit the vendor link.
    match /driver_invites/{phone} {
      allow read: if isAdmin()
                  || (isSignedIn() && authPhone() == phone)
                  || (isVendor() && resource.data.vendorId == uid());
      allow create: if can('people') || (
                       isApprovedVendor()
                       && request.resource.data.vendorId == uid()
                       && request.resource.data.get('preApproved', false) == false
                     );
      allow update, delete: if can('people')
                             || (isVendor() && resource.data.vendorId == uid()
                                 && request.resource.data.get('vendorId', uid()) == uid()
                                 && request.resource.data.get('preApproved', false) == false);
    }

    match /vendor_invites/{phone} {
      allow read: if isAdmin() || (isSignedIn() && authPhone() == phone);
      allow write: if can('people');
    }

    // ── Vendor registration: request → one-time invitation → account ────────
    // All three are written only by the callables in vendorOnboarding.ts. The
    // invitation id is the SHA-256 of the token, so reading the document does
    // not let anyone redeem it.
    match /vendor_requests/{uid} {
      allow read: if isOwner(uid) || can('people');
      allow write: if false;
    }
    match /vendor_invitations/{id} {
      allow read: if can('people');
      allow write: if false;
    }

    // ── Vehicle register lookups (functions/src/vehicleLookup.ts) ───────────
    // Cached VAHAN records, keyed by the plate. Staff reviewing a driver or a
    // fleet read them; no client can write one, so "verified from the register"
    // cannot be forged from an app.
    match /vehicle_lookups/{registration} {
      allow read: if can('people') || can('fleet');
      allow write: if false;
    }
    match /vehicle_lookup_quota/{uid} {
      allow read, write: if false;
    }

    // ── Vendors ─────────────────────────────────────────────────────────────
    // Statuses in which the vendor may edit and (re)submit the application.
    // 'Pending' / 'Needs Correction' / 'Rejected' are legacy spellings.
    function vendorEditableStatus(status) {
      return status in ['INCOMPLETE', 'CHANGES_REQUESTED', 'REJECTED',
                        'Pending', 'Needs Correction', 'Rejected'];
    }
    // Top-level fields the vendor may ever write on its own doc. Everything
    // else (review, verified, commission, walletBalance, …) is admin-only.
    function vendorOwnerKeys() {
      return ['uid', 'role', 'phone', 'status', 'onboardingStep', 'business',
              'documents', 'fleet', 'payoutSummary', 'companyName', 'name',
              'contactPerson', 'owner', 'email', 'city', 'fleetSize',
              'totalFleetSize', 'gstin', 'panNumber', 'submittedAt',
              'createdAt', 'updatedAt'];
    }
    function vendorInvitePreApproved() {
      return authPhone() != ''
             && exists(docPath('vendor_invites', authPhone()))
             && get(docPath('vendor_invites', authPhone())).data.get('preApproved', false) == true;
    }
    // Submission (spec page 13): business + account details and at least one
    // vehicle with its documents, stamped with server time. Goes to
    // PENDING_APPROVAL, or straight to APPROVED for an admin pre-approved
    // phone number on a first submission.
    function vendorSubmitOk() {
      let d = request.resource.data;
      return d.submittedAt == request.time
             && d.business is map && d.payoutSummary is map && d.fleet is map
             && d.fleet.vehicles is list
             && d.fleet.vehicles.size() > 0
             && d.fleet.vehicles.size() <= 100
             && (d.status == 'PENDING_APPROVAL'
                 || (d.status == 'APPROVED'
                     && resource.data.status in ['INCOMPLETE', 'Pending']
                     && vendorInvitePreApproved()));
    }
    // Sign-up with a vehicle number: a phone-verified owner creates its own vendor document,
    // already submitted for review (PENDING_APPROVAL) and listing at least one vehicle. Only the
    // owner-writable keys may be present, so approval, review, commission and wallet fields can
    // never be set at sign-up; staff approval still decides whether the account is usable.
    function vendorSelfCreateOk() {
      let d = request.resource.data;
      return authPhone() != ''
             && d.keys().hasOnly(vendorOwnerKeys())
             && d.uid == uid() && d.role == 'vendor' && d.phone == authPhone()
             && d.status == 'PENDING_APPROVAL'
             && d.submittedAt == request.time && d.createdAt == request.time
             && d.fleet is map && d.fleet.vehicles is list
             && d.fleet.vehicles.size() > 0 && d.fleet.vehicles.size() <= 100
             && !exists(docPath('customers', uid()))
             && !exists(docPath('drivers', uid()));
    }
    match /vendors/{id} {
      // Staff can create a vendor, and a verified owner can sign up with a vehicle number
      // (vendorSelfCreateOk). redeemVendorInvitation (invitation links) still works as well.
      allow create: if (can('people') && canAct('Vendors', 'create')) || (isOwner(id) && vendorSelfCreateOk());
      // Only the vendor itself, admins, and drivers attached to this vendor.
      // (Bank/ID numbers are not here — see vendor_kyc.)
      allow read: if isOwner(id) || isAdmin()
                  || (isDriver() && get(docPath('drivers', uid())).data.get('vendorId', '') == id);
      allow update: if (can('people')
                        && staffPartnerOk('Vendors', canAct('Vendors', 'approve'), canAct('Vendors', 'edit'),
                                          ['status'], ['approvalStatus', 'verified', 'review', 'approvedAt'])) || (
                       isOwner(id)
                       && changedKeys().hasOnly(vendorOwnerKeys())
                       && unchanged('role') && unchanged('uid')
                       && unchanged('phone') && unchanged('createdAt')
                       && (
                            // Draft / corrections, optionally submitting.
                            (vendorEditableStatus(resource.data.status)
                             && (unchanged('status') || vendorSubmitOk()))
                            // Approved: contact details only — legal names stay fixed.
                         || (isApprovedVendorStatus(resource.data.status)
                             && unchanged('status')
                             && onlyChanges(['business', 'email', 'city', 'updatedAt'])
                             && request.resource.data.business.vendorName == resource.data.business.vendorName
                             && request.resource.data.business.businessName == resource.data.business.businessName)
                          )
                     );
      allow delete: if can('people') && (isSuperAdmin() || isLegacyStaff());
    }

    // Private vendor KYC: full ID number + bank account. Doc id == vendor uid.
    // Writable by the vendor only while its application is editable.
    match /vendor_kyc/{id} {
      allow read: if isOwner(id)
                  || (can('people') && canAct('Vendors', 'approve'))
                  || (can('finance') && staffFlag('sensitive', 'bankDetails'));
      // Legacy people roles kept KYC uploads; a Staff ID also needs the bank-details right.
      allow create, update: if (can('people') && canAct('Vendors', 'edit') && (isLegacyStaff() || staffFlag('sensitive', 'bankDetails'))) || (
                       isOwner(id)
                       && exists(docPath('vendors', id))
                       && vendorEditableStatus(get(docPath('vendors', id)).data.status)
                       && request.resource.data.keys().hasOnly(['identityProof', 'payout', 'updatedAt'])
                     );
      allow delete: if can('people');
    }

    // ── Drivers ─────────────────────────────────────────────────────────────
    function driverInvite() {
      return get(docPath('driver_invites', authPhone())).data;
    }
    function hasDriverInvite() {
      return authPhone() != '' && exists(docPath('driver_invites', authPhone()));
    }
    // A self-registering driver may only claim a vendor link / pre-approval
    // that an invite for their own verified phone number grants.
    function driverSelfCreateOk() {
      let d = request.resource.data;
      let vendorOk = d.get('vendorId', '') == ''
                     || (hasDriverInvite() && driverInvite().get('vendorId', '') == d.vendorId);
      let statusOk = d.status == 'Pending'
                     || (d.status == 'Approved' && hasDriverInvite()
                         && driverInvite().get('preApproved', false) == true);
      return d.role == 'driver' && vendorOk && statusOk
             && d.get('verified', false) == false
             && d.get('walletBalance', 0) == 0
             && d.get('docStatus', 'Pending') == 'Pending'
             && !d.keys().hasAny(['bank', 'identity'])
             && d.get('rating', 5) == 5 && d.get('totalTrips', 0) == 0;
    }
    match /drivers/{id} {
      allow create: if (can('people') && staffFlag('partnerRights', 'createDriver')) || (isOwner(id) && driverSelfCreateOk());
      allow read: if isOwner(id) || isAdmin()
                  || (isVendor() && resource.data.vendorId == uid());
      allow update: if (can('people') && staffDriverOk())
                    // Vehicle pairing from the admin fleet screen.
                    || (can('fleet') && onlyChanges(['assignedVehicleId', 'assignedVehicleNumber', 'updatedAt']))
                    // The driver edits profile/KYC/presence, never approval —
                    // except resubmitting a rejected application for review.
                    || (isOwner(id)
                        && (unchanged('status')
                            || (resource.data.status == 'Rejected'
                                && request.resource.data.status == 'Pending'))
                        && unchanged('role')
                        && unchanged('vendorId') && unchanged('verified')
                        && unchanged('rating') && unchanged('fleetStatus')
                        && onlyChanges(['name', 'email', 'photoUrl', 'dob', 'gender', 'address', 'city', 'pincode',
                           'emergencyContactName', 'emergencyContact', 'licenseInfo', 'vehicleInfo',
                           'licenseNumber', 'licenseExpiry', 'license', 'vehicleNumber', 'vehicleType', 'vehicle',
                           'docStatus', 'submittedAt', 'updatedAt', 'presenceStatus', 'lastSeenAt', 'status', 'rejectionReason'])
                        && (unchanged('licenseInfo') && unchanged('vehicleInfo') && unchanged('licenseNumber')
                            && unchanged('licenseExpiry') && unchanged('vehicleNumber') && unchanged('vehicleType')
                            || request.resource.data.docStatus == 'Pending')
                        && (unchanged('docStatus') || request.resource.data.docStatus == 'Pending'))
                    // The owning vendor manages fleet-side fields only.
                    || (isApprovedVendor() && resource.data.get('vendorId', '') == uid()
                        && onlyChanges(['assignedVehicleId', 'assignedVehicleNumber',
                                        'fleetStatus', 'updatedAt']));
      allow delete: if can('people') && (isSuperAdmin() || isLegacyStaff());
    }

    // Full bank/identity information is visible only to this driver and to
    // staff who review KYC or pay out.
    match /driver_private/{id} {
      allow read: if isOwner(id)
                  || (can('people') && staffFlag('partnerRights', 'approveDriverDocs'))
                  || (can('finance') && staffFlag('sensitive', 'bankDetails'));
      allow create, update: if (can('people') && staffFlag('partnerRights', 'createDriver') && (isLegacyStaff() || staffFlag('sensitive', 'bankDetails'))) || (isOwner(id)
        && existsAfter(docPath('drivers', id))
        && request.resource.data.keys().hasOnly(['bank', 'identity', 'updatedAt'])
        && (!request.resource.data.keys().hasAny(['identity']) || (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['identity']))
            || getAfter(docPath('drivers', id)).data.docStatus == 'Pending'));
      allow delete: if can('people');
    }

    // ── Fleet ───────────────────────────────────────────────────────────────
    // Fields only a reviewer sets.
    function vehicleReviewKeys() {
      return ['reviewedAt', 'reviewedBy', 'approvedAt'];
    }
    match /vehicles/{vehicleId} {
      // Staff, the owning vendor, and the driver the vehicle is paired with.
      allow read: if isAdmin()
                  || (isVendor() && resource.data.get('vendorId', '') == uid())
                  || (isDriver() && resource.data.get('assignedDriverId', '') == uid());
      allow create: if (can('fleet') && staffFlag('partnerRights', 'createVehicle')) || (
                       isApprovedVendor()
                       && request.resource.data.vendorId == uid()
                       && request.resource.data.docStatus == 'Pending'
                       && !request.resource.data.keys().hasAny(vehicleReviewKeys())
                     );
      // A vendor may change operational fields freely; any other change
      // (number, category, documents, expiries…) sends the vehicle back to
      // document review.
      allow update: if (can('fleet')
                        && staffPartnerOk('Vehicles',
                                          canAct('Vehicles', 'approve') && staffFlag('partnerRights', 'approveVehicleDocs'),
                                          canAct('Vehicles', 'edit') || staffFlag('partnerRights', 'createVehicle'),
                                          [], ['approvalStatus', 'docStatus', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'approvedAt'])
                        // Vehicle `status` doubles as the older account hold (Inactive): a Staff ID changes it
                        // with an account action, or between Active and Maintenance as an ordinary edit.
                        && (isSuperAdmin() || unchanged('status') || changedKeys().hasAny(['accountStatus', 'approvalStatus'])
                            || (canAct('Vehicles', 'edit')
                                && request.resource.data.get('status', '') in ['Active', 'Maintenance']
                                && resource.data.get('status', 'Active') in ['Active', 'Maintenance'])))
                    // Category rename keeps the copied name in step.
                    || (can('pricing') && onlyChanges(['category', 'categoryId', 'updatedAt']))
                    || (isApprovedVendor()
                        && resource.data.vendorId == uid()
                        && unchanged('vendorId')
                        && !changedKeys().hasAny(vehicleReviewKeys())
                        && ((unchanged('docStatus')
                             && onlyChanges(['status', 'assignedDriverId', 'assignedDriverName', 'updatedAt']))
                            || request.resource.data.docStatus == 'Pending'));
      // Approved or driver-paired vehicles may be referenced by trips: the
      // vendor deactivates them instead of deleting.
      allow delete: if (can('fleet') && (isSuperAdmin() || isLegacyStaff()))
                     || (isApprovedVendor()
                         && resource.data.vendorId == uid()
                         && resource.data.get('docStatus', 'Pending') != 'Approved'
                         && resource.data.get('assignedDriverId', '') == '');
    }

    match /vehicle_categories/{catId} {
      allow read: if isSignedIn();
      allow write: if can('pricing');
    }

    // ── Bookings ────────────────────────────────────────────────────────────
    function booking(id) {
      return get(docPath('bookings', id)).data;
    }
    // Post-write view, so a booking and its companion docs can be written
    // together in one batch.
    function bookingAfter(id) {
      return getAfter(docPath('bookings', id)).data;
    }
    function marketplaceStatus(id) {
      return exists(docPath('marketplace_trips', id))
             ? get(docPath('marketplace_trips', id)).data.status
             : '';
    }
    function bookingSecret(id) {
      return get(docPath('booking_secrets', id)).data;
    }

    // Customer may cancel (before the trip starts) or rate a completed trip.
    // The cancellation fee the rider was quoted is recorded for the admin;
    // it is informational (never a charge) and bounded.
    function customerUpdateOk() {
      let d = request.resource.data;
      return (
               onlyChanges(['status', 'cancelReason', 'cancelledBy', 'cancelledAt',
                            'cancellationFee', 'updatedAt'])
               && d.status == 'Cancelled'
               && resource.data.status in ['Pending', 'Approved', 'Confirmed', 'Assigned']
               && d.get('cancellationFee', 0) is number
               && d.get('cancellationFee', 0) >= 0
               && d.get('cancellationFee', 0) <= 500
             ) || (
               onlyChanges(['rating', 'reviewComment', 'ratedAt', 'updatedAt'])
               && resource.data.status == 'Completed'
               && d.rating is int && d.rating >= 1 && d.rating <= 5
             );
    }

    // A vehicle a trip may be assigned to, referenced by its stable id: owned
    // by `owner` ('' = NESAM-owned / independent), documents approved, in
    // service, and the booking's copied number matches the record.
    function assignableVehicle(vehicleId, owner, number) {
      let v = get(docPath('vehicles', vehicleId)).data;
      return v.get('vendorId', '') == owner
             && v.get('docStatus', '') == 'Approved'
             && !(v.get('status', 'Active') in ['Inactive', 'Maintenance'])
             && number == v.get('vehicleNumber', '');
    }

    // A vendor assigns its driver and vehicle through the vendorAssignDriver function
    // (functions/src/vendorDispatch.ts), which also checks seats, documents through
    // the pickup and schedule overlap. There is deliberately no direct client write.

    // The assigned driver may keep toll receipts and the live position on a trip.
    // Status, trip stage, OTP, odometer and verification are written only by the
    // advanceTrip / verifyBoarding / vehicle-verification functions.
    function driverProgressOk(id) {
      let d = request.resource.data;
      return isApprovedDriver()
             && resource.data.get('assignedDriverId', '') == uid()
             && unchanged('status')
             && resource.data.status in ['Assigned', 'Ongoing']
             && d.get('tollCharges', 0) is number
             && d.get('tollCharges', 0) >= 0 && d.get('tollCharges', 0) <= 50000
             && onlyChanges(['tolls', 'tollCharges', 'driverLocation', 'updatedAt']);
    }

    // Booking fields owned by finance; operations staff never set them. Payment
    // fields (payment, paymentStatus, paymentSummary, paidAt, refund) are written
    // only by the recordPayment / updateRefund functions.
    function financeBookingKeys() {
      return ['tollsApproved', 'invoiceId', 'invoiceNumber'];
    }
    // Price and partner money: written only by the booking / marketplace /
    // ledger functions (partners' own claims are checked above).
    function serverMoneyKeys() {
      return ['fare', 'fareBreakdown', 'fareOverride', 'fareVerified', 'commission', 'finance',
              'vendorPayout', 'driverPayout', 'payoutSource'];
    }
    // Who earns from a trip is decided with its payout: by the marketplace
    // functions (award / assign) or the partner's own claim and dispatch.
    function partnerAssignmentKeys() {
      return ['assignedVendorId', 'assignedVendorName', 'assignedDriverId', 'assignedDriverName',
              'driver', 'driverPhone', 'assignedVehicleId', 'assignedVehicleNumber'];
    }

    match /bookings/{bookingId} {
      // Bookings are created only by the createBooking / createAdminBooking
      // functions, which price them; the price is changed only through
      // overrideBookingFare (reason + audit). No client may write it.
      allow create: if false;
      // Booking documents carry partner payouts and margin: staff without the payout right get
      // redacted bookings from getStaffBookings (functions/src/staffReads.ts) instead.
      allow read: if staffFlag('sensitive', 'vendorPayout')
                  || (isSignedIn() && resource.data.customerId == uid())
                  || (isVendor() && resource.data.assignedVendorId == uid())
                  || (isDriver() && resource.data.assignedDriverId == uid());
      // A completed trip is financially finalized: operations may only
      // correct its contact details.
      // Operations staff correct contact details here. Approval, rejection,
      // cancellation, assignment, payments, refunds and trip stages each have
      // their own validated function.
      // Customer contact details are not on this document (booking_contacts holds them; staff change
      // them with updateBookingContact). A marketplace claim is the claimMarketplaceDuty function:
      // no client write can assign a duty or set a payout.
      allow update: if (can('operations') && onlyChanges(['notes', 'updatedAt']))
                    || (can('finance') && onlyChanges(financeBookingKeys().concat(['updatedAt'])))
                    || (isSignedIn() && resource.data.customerId == uid() && customerUpdateOk())
                    || driverProgressOk(bookingId);
      allow delete: if isSuperAdmin();
    }

    // Append-only audit trail written alongside booking changes (created,
    // cancelled, rated, sos…). Only the booking's own customer, assigned
    // driver or assigned vendor may add an entry, stamped with their own uid.
    // bookingAfter() lets the entry ride in the same batch as the change.
    function bookingParticipantAfter(id) {
      let b = bookingAfter(id);
      return b.get('customerId', '') == uid()
             || b.get('assignedDriverId', '') == uid()
             || b.get('assignedVendorId', '') == uid();
    }
    match /bookings/{bookingId}/events/{eventId} {
      allow create: if isAdmin() || (
                       isSignedIn()
                       && request.resource.data.actorId == uid()
                       && bookingParticipantAfter(bookingId)
                     );
      // Events and assignment history record payouts: staff need the payout right.
      allow read: if staffFlag('sensitive', 'vendorPayout') || (
                     isSignedIn()
                     && (booking(bookingId).get('customerId', '') == uid()
                         || booking(bookingId).get('assignedDriverId', '') == uid()
                         || booking(bookingId).get('assignedVendorId', '') == uid())
                   );
      allow update, delete: if isSuperAdmin();
    }

    // Rider SOS alerts for their own booking; handled by admins.
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn()
                     && request.resource.data.customerId == uid()
                     && request.resource.data.status == 'Open'
                     && booking(request.resource.data.bookingId).customerId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == uid());
      allow update, delete: if can('operations');
    }

    // Boarding OTP lives apart from the booking so drivers/vendors (who can
    // read the booking) never see it. Doc id == booking id. Written only by
    // the booking functions.
    match /booking_secrets/{bookingId} {
      allow create, update, delete: if false;
      allow read: if can('operations') || (isSignedIn() && resource.data.customerId == uid());
    }

    // ── Marketplace ─────────────────────────────────────────────────────────
    // Doc id == booking id. Partners see offers still open to them and the
    // trips they won — never other partners' assigned trips.
    match /marketplace_trips/{tripId} {
      allow read: if staffFlag('sensitive', 'vendorPayout')
                  || (isApprovedVendor()
                      && (resource.data.status in ['Open', 'Bidding']
                          || resource.data.get('assignedVendorId', '') == uid()))
                  || (isApprovedIndependentDriver()
                      && (resource.data.status == 'Open'
                          || resource.data.get('assignedDriverId', '') == uid()));
      // Created, priced, claimed and escalated only by the marketplace functions. The one client
      // write left is the customer withdrawing the offer when cancelling their own booking.
      allow create: if false;
      allow update: if (can('operations') && !changedKeys().hasAny(['offeredPayout', 'escalation', 'mode', 'status', 'assignedVendorId', 'assignedDriverId']))
                    || (isSignedIn()
                        && booking(tripId).customerId == uid()
                        && request.resource.data.status == 'Closed'
                        && onlyChanges(['status', 'updatedAt']));
      allow delete: if can('operations');

      // Bids are submitted, withdrawn and awarded by submitMarketplaceBid / withdrawMarketplaceBid /
      // awardMarketplaceBid, which apply the same eligibility as a claim. Partners read their own.
      match /bids/{bidId} {
        allow create, update, delete: if false;
        allow read: if staffFlag('sensitive', 'vendorPayout')
                    || (isVendor() && resource.data.get('vendorId', '') == uid())
                    || (isDriver() && resource.data.get('driverId', '') == uid());
      }
    }

    // Collection-group reads of bids (admin review queue, vendor "my bids").
    match /{path=**}/bids/{bidId} {
      allow read: if isAdmin()
                  || (isVendor() && resource.data.get('vendorId', '') == uid())
                  || (isDriver() && resource.data.get('driverId', '') == uid());
    }

    // ── Customer contact privacy ───────────────────────────────────────────
    // Raw phone / WhatsApp / email: staff and the booking's own customer only. Partners never read
    // this collection; the assigned driver's number comes from getCustomerContact (T-8h, logged).
    match /booking_contacts/{bookingId} {
      allow read: if isSuperAdmin() || (isAdmin() && isLegacyStaff()) || (isSignedIn() && resource.data.get('customerId', '') == uid());
      allow write: if false;
    }
    match /contact_access_logs/{logId} {
      allow read: if can('operations');
      allow write: if false;
    }

    // ── Partner settlement due-tracking (written by the settlement functions) ──
    match /settlement_dues/{bookingId} {
      allow read: if canReadPayouts()
                  || (isVendor() && resource.data.get('partnerId', '') == uid())
                  || (isDriver() && resource.data.get('partnerId', '') == uid());
      allow write: if false;
    }

    // ── Payouts ─────────────────────────────────────────────────────────────
    match /payout_requests/{requestId} {
      allow create: if false; // requestPartnerPayout checks and reserves settled funds.
      allow read: if canReadPayouts()
                  || (isVendor() && resource.data.vendorId == uid())
                  || (isDriver() && resource.data.driverId == uid());
      // Finance records the outcome; the requested amount and partner never change.
      allow update: if can('finance')
                    && unchanged('amount') && unchanged('driverId') && unchanged('vendorId')
                    && canAct('Accounts', 'approve') && withinBankLimit(resource.data.get('amount', 0));
      allow delete: if isSuperAdmin();
    }

    // ── Partner ledger and wallets (server-written only) ────────────────────
    // wallet_ledger entries and the wallets/{type}_{id} balances derived from
    // them are written by the ledger functions alone (functions/src/ledger.ts).
    match /wallet_ledger/{entryId} {
      allow read: if canReadPayouts()
                  || (isVendor() && resource.data.vendorId == uid())
                  || (isDriver() && resource.data.driverId == uid());
      allow write: if false;
    }
    // Keyed {type}_{uid}; matching on the id lets a partner read their
    // wallet before the server has created it (an empty wallet, not an error).
    match /wallets/{walletId} {
      allow read: if canReadPayouts()
                  || (isVendor() && walletId == 'vendor_' + uid())
                  || (isDriver() && walletId == 'driver_' + uid());
      allow write: if false;
    }
    // Commission policy: saved only through saveCommissionPolicy (finance).
    match /business_config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Customer extras ─────────────────────────────────────────────────────
    match /saved_places/{placeId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == uid();
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerId == uid());
      allow delete: if can('people') || (isSignedIn() && resource.data.ownerId == uid());
      allow update: if can('people') || (
                       isSignedIn() && resource.data.ownerId == uid()
                       && request.resource.data.ownerId == uid()
                     );
    }

    // Location-scoped service rules (availability, cab types, fare / payout adjustments, fare
    // limits). The booking server applies enabled rules; every change keeps its history.
    // Written only by saveServiceRule / setServiceRuleStatus, which validate and audit it.
    match /service_rules/{ruleId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Invoice drafts saved while billing / tax details are checked; issuing assigns the number.
    match /invoice_drafts/{draftId} {
      allow read: if canReadFinance();
      allow create, update: if can('finance') && request.resource.data.createdBy == uid();
      allow delete: if can('finance');
    }
    // Office accounting registers (Accounts). Entered once; only review / match / verification status
    // may change afterwards, and every change records who made it.
    match /accounts_register/{entryId} {
      allow read: if canReadPayouts();
      allow create: if can('finance') && request.resource.data.createdBy == uid() && request.resource.data.amount is number;
      allow update: if can('finance')
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itcStatus', 'matchStatus', 'matchedRef', 'status', 'verifiedByName', 'verifiedAt']);
      allow delete: if false;
    }
    match /counters/accounts_closing {
      allow read, write: if can('finance');
    }
    // Full & Final closures of partner IDs (append-only; reopening is a separate super-admin action).
    match /ff_records/{recordId} {
      allow read: if canReadFinance() || can('people');
      allow create: if (can('people') || can('finance')) && request.resource.data.closedBy == uid();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }
    // Communication › Messages & notices. Staff compose Drafts and may edit or cancel them (or
    // cancel a schedule); only the server (sendNoticeCampaign / periodicJobs) schedules or sends.
    match /notice_campaigns/{campaignId} {
      allow read: if can('engagement');
      allow create: if can('engagement') && request.resource.data.status == 'Draft'
                     && request.resource.data.createdBy == uid();
      allow update: if can('engagement') && (
                       (resource.data.status == 'Draft' && request.resource.data.status in ['Draft', 'Cancelled']
                        && unchanged('createdBy'))
                       || (resource.data.status == 'Scheduled' && request.resource.data.status == 'Cancelled'
                           && onlyChanges(['status', 'cancelledAt', 'cancelledBy', 'cancelledByName', 'cancelReason']))
                     );
      allow delete: if false;
    }
    // Account notices: suspension / reactivation emails queued when an account status changes.
    match /account_notices/{noticeId} {
      allow read: if can('people') || can('engagement');
      allow create: if (can('people') || can('fleet')) && request.resource.data.createdBy == uid()
                     && request.resource.data.status in ['Queued', 'Email not supplied'];
      allow update: if (can('people') || can('engagement'))
                     && onlyChanges(['status', 'preparedAt', 'preparedByName', 'attempts', 'error']);
      allow delete: if false;
    }
    // Staff activity: one session per signed-in browser tab (heartbeat, explicit logout) and an
    // append-only log of page views, logins and customer-data access. The Master ends sessions
    // through revokeStaffSessions (server); the tab signs itself out when its session is revoked.
    match /staff_sessions/{sessionId} {
      allow read: if isSuperAdmin() || can('system') || (isAdmin() && resource.data.uid == uid());
      allow create: if isAdmin() && request.resource.data.uid == uid() && request.resource.data.status == 'Online';
      allow update: if isAdmin() && resource.data.uid == uid() && resource.data.status == 'Online'
                     && request.resource.data.status in ['Online', 'Logged out', 'Expired']
                     && onlyChanges(['lastActiveAt', 'status', 'endedAt']);
      allow delete: if false;
    }
    match /staff_activity/{eventId} {
      allow read: if isSuperAdmin() || can('system');
      allow create: if isAdmin() && request.resource.data.uid == uid();
      allow update, delete: if false;
    }
    // Data exports from the record lists: who exported what, when, with which filters.
    match /export_logs/{logId} {
      allow read: if isSuperAdmin() || can('system');
      allow create: if isAdmin() && request.resource.data.staffUid == uid() && request.resource.data.count is int;
      allow update, delete: if false;
    }
    // Customer privacy & access: reveal requests (staff ask, super admins decide) and per-staff
    // privacy controls. The reveal itself and its log stay server-side (getCustomerContact).
    match /privacy_requests/{requestId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.staffUid == uid());
      allow create: if isAdmin() && request.resource.data.staffUid == uid() && request.resource.data.status == 'Pending'
                     && staffFlag('privacy', 'requestApproval');
      allow update: if isSuperAdmin() && request.resource.data.status in ['Approved', 'Denied', 'Revoked', 'Used', 'Expired']
                     && request.resource.data.staffUid == resource.data.staffUid;
      allow delete: if false;
    }
    match /privacy_staff/{staffUid} {
      allow read: if isSuperAdmin() || (isAdmin() && staffUid == uid());
      allow write: if isSuperAdmin();
    }
    // Office follow-ups behind the Master Admin alerts (partner calls, driver acknowledgement
    // follow-ups). Append-only: staff add a record, nobody edits or deletes one.
    match /office_followups/{followupId} {
      allow read: if can('operations');
      allow create: if can('operations') && request.resource.data.createdBy == uid()
                     && request.resource.data.kind in ['partner_call', 'driver_ack', 'customer_call', 'trip_issue']
                     && request.resource.data.bookingId is string;
      allow update, delete: if false;
    }
    // Which staff member handles a booking ("Take ownership" / "Assign handling staff"). Every write
    // records who made it.
    match /booking_ownership/{bookingId} {
      allow read: if can('operations');
      allow create, update: if can('operations') && request.resource.data.assignedByUid == uid();
      allow delete: if isSuperAdmin();
    }
    // Business accounts (agencies, hotels, corporate desks). People staff manage them; operations
    // staff read them to book for a business. Codes come from counters/business_accounts.
    match /business_accounts/{accountId} {
      allow read: if can('people') || can('operations') || canReadFinance();
      allow create, update: if can('people');
      allow delete: if false;
      match /api_credentials/{credId} {
        allow read: if can('people') || can('system');
        allow create: if (can('people') || can('system')) && request.resource.data.createdBy == uid() && request.resource.data.status == 'Active';
        allow update: if (can('people') || can('system')) && request.resource.data.status == 'Revoked' && request.resource.data.hash == resource.data.hash;
        allow delete: if false;
      }
      match /payments/{paymentId} {
        allow read: if can('people') || canReadFinance();
        allow create: if (can('people') || can('finance')) && request.resource.data.createdBy == uid()
                       && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update, delete: if false;
      }
    }
    match /counters/business_accounts {
      allow read, write: if can('people');
    }
    // Office phone enquiries & quotes (Master Admin → Bookings → Enquiries & quotes). Staff-only;
    // a quote never becomes a booking here — conversion goes through createAdminBooking.
    match /enquiries/{enquiryId} {
      allow read: if can('operations');
      allow create: if can('operations')
                     && request.resource.data.keys().hasAll(['code', 'status', 'pickup', 'drop', 'createdBy'])
                     && request.resource.data.createdBy == uid()
                     && request.resource.data.status in ['New', 'Call back', 'No response', 'Draft', 'Converted', 'Closed', 'Expired'];
      allow update: if can('operations')
                     && request.resource.data.status in ['New', 'Call back', 'No response', 'Draft', 'Converted', 'Closed', 'Expired']
                     && request.resource.data.code == resource.data.code
                     && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn()
                     && request.resource.data.customerId == uid()
                     && request.resource.data.status == 'Open';
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == uid());
      allow update, delete: if can('engagement');
    }

    match /notifications/{notifId} {
      // Any staff action may notify the user it concerns (approvals, payouts…).
      allow create: if isAdmin();
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.recipientId == uid());
      // Recipients — and any staff member for the shared admin inbox — may
      // only mark as read.
      allow update: if can('engagement') || (
                       isSignedIn() && resource.data.get('recipientId', '') == uid()
                       && onlyChanges(['read', 'readAt', 'acknowledgedAt'])
                     ) || (
                       isAdmin() && resource.data.get('recipientId', 'admin') == 'admin'
                       && onlyChanges(['read', 'readAt'])
                     );
      allow delete: if can('engagement');
    }

    // ── Content, Masters & Catalogs ─────────────────────────────────────────
    // Renames in one module keep copied names in other modules in step; those
    // writes are limited to exactly the copied fields.
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if can('content');
      allow update: if can('pricing') && onlyChanges(['allowedVehicleCategoryNames', 'updatedAt']);
    }
    match /tour_packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if can('content');
      allow update: if can('pricing') && onlyChanges(['allowedVehicleCategoryNames', 'updatedAt']);
    }
    match /locations/{locId} {
      allow read: if isSignedIn();
      allow write: if can('content');
    }
    match /fare_rules/{ruleId} {
      allow read: if isSignedIn();
      // Managed route fares require the callable's validation and version checks.
      allow create: if can('pricing') && canAct('Settings', 'edit')
                    && request.resource.data.get('managed', false) != true;
      allow update: if can('pricing') && canAct('Settings', 'edit')
                    && resource.data.get('managed', false) != true
                    && request.resource.data.get('managed', false) != true;
      allow delete: if can('pricing') && canAct('Settings', 'edit')
                    && resource.data.get('managed', false) != true;
      allow update: if can('content')
                     && onlyChanges(['serviceName', 'originLocationName', 'destinationLocationName', 'updatedAt']);
    }
    match /coupons/{couponId} {
      allow read: if staffFlag('partnerRights', 'viewCoupons')
                  || (isSignedIn() && !exists(docPath('admins', uid())));
      // Coupon setup is a Settings change: Master and legacy pricing roles (Staff IDs never hold Settings edit).
      allow write: if can('pricing') && canAct('Settings', 'edit');
      allow update: if can('content') && onlyChanges(['serviceNames', 'updatedAt']);
    }

    // Customers may submit one review for their own completed trip; it
    // lands as 'Pending' for admin moderation. Only published reviews are
    // public.
    match /reviews/{reviewId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.customerId == uid())
                  || (isSignedIn() && resource.data.status == 'Published');
      allow create: if can('engagement') || (
                       isCustomer()
                       && reviewId == request.resource.data.bookingId
                       && request.resource.data.customerId == uid()
                       && request.resource.data.status == 'Pending'
                       && booking(reviewId).customerId == uid()
                       && booking(reviewId).status == 'Completed'
                       && request.resource.data.overallRating is int
                       && request.resource.data.overallRating >= 1
                       && request.resource.data.overallRating <= 5
                     );
      allow update, delete: if can('engagement');
    }

    match /invoices/{invoiceId} {
      allow read: if canReadFinance() || (isSignedIn() && resource.data.customerId == uid());
      allow write: if can('finance');
    }

    // ── Admin-managed collections ───────────────────────────────────────────
    // Partner requests (duty cancellation, bank change, document renewal) — written only by
    // requestDutyCancellation / submitPartnerRequest / decidePartnerRequest (functions/src/partnerOps.ts).
    match /partner_requests/{requestId} {
      allow read: if isAdmin()
                  || (isVendor() && resource.data.get('vendorId', '') == uid())
                  || (isDriver() && resource.data.get('driverId', '') == uid());
      allow write: if false;
    }
    // Security deposit per partner, keyed {type}_{uid} (setSecurityDeposit / requestDepositRefund).
    match /partner_deposits/{depositId} {
      allow read: if canReadFinance()
                  || (isVendor() && depositId == 'vendor_' + uid())
                  || (isDriver() && depositId == 'driver_' + uid());
      allow write: if false;
    }
    // Working-wallet recharge orders (createWalletRecharge / verifyWalletRecharge).
    match /wallet_recharges/{orderId} {
      allow read: if canReadFinance()
                  || (isVendor() && resource.data.get('vendorId', '') == uid())
                  || (isDriver() && resource.data.get('driverId', '') == uid());
      allow write: if false;
    }
    // Outstanding-dues payment orders (createDuesPayment / verifyDuesPayment).
    match /due_payments/{orderId} {
      allow read: if canReadFinance()
                  || (isVendor() && resource.data.get('vendorId', '') == uid())
                  || (isDriver() && resource.data.get('driverId', '') == uid());
      allow write: if false;
    }
    // Penalties are issued, changed, acknowledged and disputed only through
    // issuePenalty / transitionPenalty / acknowledgePenalty / disputePenalty.
    match /penalties/{penaltyId} {
      allow read: if canReadFinance()
                  || (isVendor() && resource.data.vendorId == uid())
                  || (isDriver() && resource.data.driverId == uid());
      allow write: if false;
    }
    // Mirror of the per-booking payment transactions, written only by recordPayment /
    // voidPayment: a client cannot create or edit a payment record.
    match /payments/{paymentId} {
      allow read: if canReadFinance()
                  || (isSignedIn() && resource.data.customerId == uid());
      allow write: if false;
    }
    match /b2b_partners/{partnerId} {
      allow read, write: if can('system');
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      // The invoice number counter advances with every invoice finance issues.
      allow write: if can('system') || (docId in ['invoice_sequence', 'tax_policy'] && can('finance'));
    }
    // Explicitly approved public catalog and moderated testimonial fields only.
    match /public_content/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── Booking sub-records (server-written) ────────────────────────────────
    // Every receipt, with who collected it. Staff with finance/report access and
    // the booking's own driver / vendor may read; nobody writes from a client.
    match /bookings/{bookingId}/payment_transactions/{txId} {
      allow read: if canReadFinance() || can('operations')
                  || (isSignedIn() && (booking(bookingId).get('assignedDriverId', '') == uid()
                                       || booking(bookingId).get('assignedVendorId', '') == uid()));
      allow write: if false;
    }
    // Assign / reassign / remove history. Append-only, never overwritten.
    match /bookings/{bookingId}/assignments/{entryId} {
      allow read: if staffFlag('sensitive', 'vendorPayout');
      allow write: if false;
    }
    // One document per booking; written by the vehicle-verification functions.
    match /vehicle_verifications/{bookingId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.get('driverId', '') == uid())
                  || (isVendor() && booking(bookingId).get('assignedVendorId', '') == uid());
      allow write: if false;
    }
    match /capture_sessions/{sessionId} { allow read, write: if false; }
    match /vehicle_photo_hashes/{hash} { allow read, write: if false; }
    match /integrity_nonces/{nonce} { allow read, write: if false; }
    match /device_integrity/{userId} {
      allow read: if isOwner(userId) || can('system');
      allow write: if false;
    }
    match /otp_verifications/{otpId} { allow read, write: if false; }

    // ── Audit, security and delivery logs ───────────────────────────────────
    match /audit_logs/{entryId} {
      allow read: if isSuperAdmin() || can('reports') || can('compliance');
      allow write: if false;
    }
    match /security_events/{eventId} {
      allow read: if isSuperAdmin() || can('system');
      allow update: if (isSuperAdmin() || can('system'))
                       && onlyChanges(['resolved', 'resolvedBy', 'resolvedAt', 'resolutionNote']);
      allow create, delete: if false;
    }
    match /notification_deliveries/{rowId} {
      allow read: if can('engagement') || can('reports') || can('operations');
      allow write: if false;
    }

    // ── Legal documents and acceptance ──────────────────────────────────────
    // Published text is readable by any signed-in user; drafts only by staff.
    match /legal_documents/{key} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('status', '') == 'Published');
      allow write: if false;
      match /versions/{version} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /legal_acceptances/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // Customer-visible mirror of the global fare adjustment (written by saveFareAdjustment).
    match /public_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Push tokens: a device registers and removes only its own token.
    match /device_tokens/{tokenId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == uid()
                     && request.resource.data.keys().hasOnly(['ownerId', 'token', 'platform', 'role', 'createdAt'])
                     && request.resource.data.token is string && request.resource.data.token.size() < 400;
      allow read, delete: if isSignedIn() && resource.data.ownerId == uid();
      allow update: if false;
    }

    // ── Partner links (driver / vehicle moves between owner-drivers and vendors) ──
    // Written only by functions/src/partnerLinks.ts. The vendor that asked, the vendor losing the
    // record, and staff who review people or fleet can read; the one-time code lives in
    // partner_link_secrets, which nobody can read.
    match /partner_links/{linkId} {
      allow read: if can('people') || can('fleet')
                  || (isVendor() && (resource.data.get('toVendorId', '') == uid()
                                     || resource.data.get('fromVendorId', '') == uid()));
      allow write: if false;
      match /events/{eventId} {
        allow read: if can('people') || can('fleet');
        allow write: if false;
      }
    }
    match /partner_link_secrets/{linkId} { allow read, write: if false; }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
