{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["../user/app/src/*"],
      "firebase/*": ["node_modules/firebase/*"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "expo-location": ["src/platform/expoLocation.ts"],
      "react-native": ["src/platform/reactNativeStub.ts"],
      "@react-native-async-storage/async-storage": ["src/platform/reactNativeStub.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
