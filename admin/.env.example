# Base URL of the deployed NESAM HTTP API (functions/ on Vercel), with no trailing slash and no /api suffix.
# Build-time: set it in the Vercel project's Environment Variables, then redeploy.
# Leave unset to use Firebase callables instead (requires the functions to be deployed to the Firebase project).
# VITE_API_URL=https://<your-api-project>.vercel.app
